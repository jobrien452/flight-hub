# Complete local dev config. Everything is defaulted, only MAPBOX_TOKEN needs filling in.
# Copy to backend/.env for docker compose, or backend/.env.dev to run uvicorn directly.

APP_ENV=dev

# compose points this at the mongo container instead, this is for running the api directly
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=flyby

# fine locally, a real deployment must replace it
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# how long an invite/reset link stays clickable, in seconds
INVITE_TOKEN_TTL_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=3600

# where invite/reset links point, use http://localhost if you run the stack through compose
PUBLIC_BASE_URL=http://localhost:5173

# the one thing to fill in, a public pk.* token from account.mapbox.com.
# without it everything works except the map
MAPBOX_TOKEN=

# --- a way in without a mailbox ---
# creates this admin at startup with the password already set, so you can sign in
# without waiting for an invite email. Only happens when APP_ENV=dev, and never
# touches an account that already exists.
# The email has to be a real looking address, dev@localhost is rejected as invalid.
DEV_ADMIN_EMAIL=dev@flyby-robotics.dev
DEV_ADMIN_PASSWORD=local-dev-password
DEV_ADMIN_NAME=Dev Admin

# writes invite and password reset links to the log instead of emailing them, so
# you can click them out of `docker compose logs backend` with no SMTP configured
EMAIL_TO_CONSOLE=true

# only read when EMAIL_TO_CONSOLE is false, a gmail app password is easiest
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

# needed for vite on :5173 calling the api on :8000, does nothing behind compose
CORS_ORIGINS=http://localhost:5173
