# Local development overrides. Copy to backend/.env.dev and edit.
#
# Only read when APP_ENV is dev (which is the default), and layered on top of
# .env, so anything set here wins locally and is never read by a deployment.
#
# Read by pydantic from the working directory, so this applies when you run the
# API directly:
#
#     cd backend && APP_ENV=dev .venv/Scripts/python -m uvicorn app.main:app --reload
#
# Under docker compose the values come from backend/.env instead, because compose
# injects that file as container environment and never copies either file into
# the image. To get the dev admin in compose, put these keys in backend/.env.

# --- a way in without a mailbox ---
# creates this admin at startup with the password already set, so you can sign in
# without waiting for an invite email. Only happens when APP_ENV=dev, and never
# touches an account that already exists.
# The email has to be a real looking address, dev@localhost is rejected as invalid.
DEV_ADMIN_EMAIL=dev@flyby-robotics.dev
DEV_ADMIN_PASSWORD=local-dev-password
DEV_ADMIN_NAME=Dev Admin

# writes invite and password reset links to the log instead of emailing them, so
# you can click them out of `docker compose logs backend` with no SMTP configured
EMAIL_TO_CONSOLE=true

# the map token the frontend asks for at runtime, a real pk.* token is needed
# for the map to draw at all
MAPBOX_TOKEN=

# where the emailed (or logged) links should point for local work
PUBLIC_BASE_URL=http://localhost:5173
