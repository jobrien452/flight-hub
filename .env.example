# read by docker-compose.yml itself, not by either app. copy this to .env.
# the mapbox token is no longer here, it lives in backend/.env as MAPBOX_TOKEN
# and the api hands it to signed in users at runtime.

# --- HTTPS (nginx + certbot) ---
# only needed for a real deployment behind a real domain, run ./init-letsencrypt.sh
# once after setting these (DNS for both names must already point at this machine).
# leave unset for local/plain-http use.
DOMAIN=www.your-domain.com
CERTBOT_EMAIL=you@example.com
# an optional second name on the same cert that just 301s to DOMAIN, this is
# the bare apex when DOMAIN is the www one. leave unset if you don't need it.
REDIRECT_DOMAIN=your-domain.com
