# --- Environment ---
# "dev" or "prod". dev is the default, and it is what enables backend/.env.dev
# and the DEV_ADMIN_* seeding below. A real deployment MUST set this to prod.
APP_ENV=prod

# --- Mongo ---
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=flyby

# --- Auth ---
# MUST change for a real deployment, fine to leave as-is for local dev
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256

# how long an invite/reset link stays clickable, in seconds
INVITE_TOKEN_TTL_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=3600

# used to build the links sent in invite/reset emails, point this at wherever the
# frontend is actually reachable, MUST change for a real deployment, the default
# below is only correct for local dev (npm run dev)
PUBLIC_BASE_URL=http://localhost:5173

# --- Mapbox ---
# the public pk.* token the frontend uses to draw maps. it is served to signed in
# users at runtime, so rotating it only needs a restart of this service, no rebuild.
# restrict it by URL in your mapbox account, it is visible to anyone who is signed in
MAPBOX_TOKEN=

# --- SMTP (invite + password reset emails) ---
# with this on, links are written to the log instead of emailed. handy locally,
# leave it false for a real deployment
EMAIL_TO_CONSOLE=false
# any SMTP provider works, a Gmail account with an app password is the
# easiest for local dev, without these emails silently fail to send
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
