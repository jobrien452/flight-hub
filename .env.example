# read by docker-compose.yml itself (not by either app) to fill in the
# frontend's build args. Copy this to .env and fill in a real token, or
# docker compose build will bake in an empty mapbox token.
VITE_MAPBOX_TOKEN=your-mapbox-token-here

# --- HTTPS (nginx + certbot) ---
# only needed for a real deployment behind a real domain, run ./init-letsencrypt.sh
# once after setting these (DNS for DOMAIN must already point at this machine).
# leave unset for local/plain-http use.
DOMAIN=your-domain.com
CERTBOT_EMAIL=you@example.com
